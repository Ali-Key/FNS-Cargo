# FSN Cargo - SPA history fallback for Apache / LiteSpeed (Hostinger).
# React Router owns /dashboard, /login and every public route. Without this
# rewrite a direct load or a refresh of those URLs is looked up on disk, finds
# no file, and the host serves its own 404 page instead of the app.
# Vite copies this file into dist/, so it must be uploaded with the build.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and directories (assets, images, logos) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is handed to the SPA entry point.
  RewriteRule . /index.html [L]
</IfModule>
